# ===== LLM（OpenAI 兼容接口；DeepSeek 填 https://api.deepseek.com/v1）=====
# 留空则 LangGraph 各节点走降级逻辑并明确标注，服务不会崩溃
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# mock = 离线演示模式（确定性输出，供测试/无 Key 体验全流程）；api = 真实调用
LLM_PROVIDER=api

# ===== Embedding =====
# local = 内置哈希向量（离线可用）；api = OpenAI 兼容 embeddings 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# ===== 数据库 =====
# Docker 部署（PostgreSQL + pgvector）：
DATABASE_URL=postgresql+psycopg://regpilot:regpilot@localhost:5432/regpilot
# 本机无 Docker 时的开发降级（SQLite，向量检索自动切换为本地实现）：
# DATABASE_URL=sqlite:///./regpilot.db

# 启动时是否写入种子数据（ABC Technology / SmartWatch X1 / 预置法规条款）
RUN_SEED=true
