{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataShield",
  "version": "0.2.0-rc.3",
  "identifier": "com.datashield.desktop",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../frontend run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix ../../frontend ci && npm --prefix ../../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "DataShield",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/datashield-local"
    ],
    "resources": {
      "binaries/_internal/": "_internal/"
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
