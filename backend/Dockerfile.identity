FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

COPY backend/requirements-identity.txt .
RUN pip install -r requirements-identity.txt
COPY backend/ ./

EXPOSE 8001
CMD ["sh", "-c", "alembic -c alembic-identity.ini upgrade head && exec python -m uvicorn identity_service.main:app --host 0.0.0.0 --port 8001"]
