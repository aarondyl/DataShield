FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

COPY requirements-identity.txt .
RUN pip install -r requirements-identity.txt
COPY identity_service/ ./identity_service/
COPY alembic-identity.ini ./alembic-identity.ini
COPY app/__init__.py ./app/__init__.py
COPY app/core/__init__.py ./app/core/__init__.py
COPY app/core/passwords.py ./app/core/passwords.py

EXPOSE 8001
CMD ["sh", "-c", "python -m identity_service.validate_env && exec python -m uvicorn identity_service.main:app --host 0.0.0.0 --port 8001"]
