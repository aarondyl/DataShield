FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 RUNTIME_MODE=cloud RUN_SEED=false

COPY backend/requirements.txt .
RUN pip install -r requirements.txt
COPY backend/ .

EXPOSE 8000
# 云端镜像只暴露公共法规 API；不复制 React 产物，也不载入私有业务路由。
CMD ["sh", "-c", "alembic upgrade head && exec python -m app.entrypoints.cloud"]
