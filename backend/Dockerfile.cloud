FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 RUNTIME_MODE=cloud RUN_SEED=false

COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app/ ./app/
COPY alembic_cloud/ ./alembic_cloud/
COPY alembic-cloud.ini ./alembic-cloud.ini

EXPOSE 8000
# Deploy performs the migration after a database backup; startup only validates config.
CMD ["sh", "-c", "python -m app.entrypoints.validate_cloud_env && exec python -m app.entrypoints.cloud"]
