# ===== LLM（OpenAI 兼容接口；DeepSeek 填 https://api.deepseek.com/v1）=====
# 留空则 LangGraph 各节点走降级逻辑并明确标注，服务不会崩溃
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# mock = 离线演示模式（确定性输出，供测试/无 Key 体验全流程）；api = 真实调用
LLM_PROVIDER=mock

# ===== Embedding =====
# local = 内置哈希向量（离线可用）；api = OpenAI 兼容 embeddings 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=5

# ===== 数据库 =====
# 本地开发默认使用 SQLite；Docker Compose 会覆盖为 PostgreSQL + pgvector：
DATABASE_URL=sqlite:///./datashield.db
# DATABASE_URL=postgresql+psycopg://datashield:datashield@localhost:5432/datashield

# 启动时是否写入种子数据（ABC Technology / SmartWatch X1 + 三部 MVP 法规全量入库）
RUN_SEED=true

# ===== 全局法规智能层：法规来源定时轮询（MVP 可选，默认关闭）=====
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_HOURS=24
