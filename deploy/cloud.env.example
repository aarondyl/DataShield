# Non-secret Compose/runtime settings. Deployment copies this file to
# /opt/datashield/secrets/cloud.env only when no file exists there.
# Caddy obtains and renews HTTPS certificates for CLOUD_DOMAIN automatically.
# Reuse the existing admin-owned production Secret directory without moving it.
CLOUD_SECRETS_DIR=/opt/datashield-cloud/secrets
COMPOSE_PROJECT_NAME=source
CLOUD_BIND_ADDRESS=127.0.0.1
IDENTITY_BIND_ADDRESS=127.0.0.1
CLOUD_HTTP_BIND_ADDRESS=0.0.0.0
CLOUD_HTTPS_BIND_ADDRESS=0.0.0.0
CLOUD_DOMAIN=api.datashield.ltd
SCHEDULER_ENABLED=true
GHCR_PULL_USERNAME=aarondyl

# Email verification and the hosted DeepSeek Gateway require these settings.
# Fill SMTP values on the server. Keep SMTP password/API keys in the separate
# 0600 secret files listed in deploy/cloud-secrets.md.
IDENTITY_EMAIL_VERIFY_REQUIRED=true
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_USER=
IDENTITY_EMAIL_FROM=
IDENTITY_SMTP_STARTTLS=true
IDENTITY_LLM_MODEL=deepseek-flash
