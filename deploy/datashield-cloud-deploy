#!/usr/bin/env bash
set -Eeuo pipefail
set +x
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

ROOT=/opt/datashield
SECRETS="$ROOT/secrets"
STATE="$ROOT/current.env"
ACTIVE="$ROOT/active-sha"
PROJECT=source
PROJECT_DIR=/opt/datashield-cloud/source
BASE="$PROJECT_DIR/docker-compose.cloud.yml"
ECS_BASE="$PROJECT_DIR/docker-compose.ecs.yml"
EXTRA_FILES=()
EXTRA_ENV_FILES=()
COMPOSE=(docker compose)
LOG="$ROOT/deploy.log"
docker_config=""
diagnostic_tmp=""

die() { printf 'Cloud deploy preflight failed: %s\n' "$1" >&2; exit 1; }
log() { printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }
valid_sha() { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }
valid_digest() { [[ "$1" =~ ^sha256:[0-9a-f]{64}$ ]]; }
id_helper=/usr/local/libexec/datashield-cloud/container-id.sh
[[ -r "$id_helper" ]] || die 'container ID normalization helper is not installed'
source "$id_helper"
release_helper=/usr/local/libexec/datashield-cloud/cloud-release-artifact.sh
[[ -r "$release_helper" ]] || die 'Cloud release artifact helper is not installed'
source "$release_helper"
compose() {
  local args=(--project-name "$PROJECT" --project-directory "$PROJECT_DIR")
  [[ ! -f "$PROJECT_DIR/.env" ]] || args+=(--env-file "$PROJECT_DIR/.env")
  args+=(--env-file "$SECRETS/cloud.env" -f "$BASE" -f "$ECS_BASE")
  args+=("${EXTRA_ENV_FILES[@]}")
  args+=("${EXTRA_FILES[@]}")
  "${COMPOSE[@]}" "${args[@]}" "$@"
}

existing_postgres_id() {
  local ids container_ref
  ids="$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter label=com.docker.compose.service=postgres)"
  [[ "$(printf '%s\n' "$ids" | sed '/^$/d' | wc -l)" -eq 1 ]] || die 'expected exactly one running PostgreSQL service in existing Compose project source'
  container_ref="$(printf '%s\n' "$ids" | sed '/^$/d')"
  container_full_id "$container_ref" || die 'could not resolve running PostgreSQL container to its full ID'
}

assert_existing_storage() {
  local pg_id mount compose_pg compose_pg_ref networks cloud_ids cloud_port
  pg_id="$(existing_postgres_id)"
  [[ "$(docker inspect --format '{{.State.Health.Status}}' "$pg_id")" == healthy ]] || die 'existing PostgreSQL container is not healthy'
  mount="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql/data"}}{{.Name}}{{end}}{{end}}' "$pg_id")"
  [[ "$mount" == source_cloud_postgres_data ]] || die 'running PostgreSQL data mount is not source_cloud_postgres_data; refusing deployment'
  docker volume inspect source_cloud_postgres_data >/dev/null 2>&1 || die 'existing PostgreSQL volume source_cloud_postgres_data was not found'
  compose_pg_ref="$(compose ps -q postgres)"
  [[ -n "$compose_pg_ref" ]] || die 'Compose did not return a PostgreSQL container ID'
  compose_pg="$(container_full_id "$compose_pg_ref")" || die 'could not resolve Compose PostgreSQL container to its full ID'
  [[ "$compose_pg" == "$pg_id" ]] || die 'Compose files do not resolve postgres to the running source project container'
  networks="$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}' "$pg_id")"
  [[ " $networks " == *" source_cloud_database "* ]] || die 'existing PostgreSQL is not attached to source_cloud_database; refusing deployment'
  compose --profile identity --profile production config --format json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d["volumes"]["cloud_postgres_data"]; assert v.get("name")=="source_cloud_postgres_data"; assert any(x.get("type")=="volume" and x.get("source")=="cloud_postgres_data" and x.get("target")=="/var/lib/postgresql/data" for x in d["services"]["postgres"]["volumes"]); assert d["networks"]["cloud_database"].get("name")=="source_cloud_database"; p=d["services"]["cloud"]["ports"]; assert any(x.get("host_ip")=="127.0.0.1" and x.get("published")=="8000" for x in p)' >/dev/null \
    || die 'candidate Compose definition does not preserve the existing PostgreSQL volume/network or localhost Cloud API port'
  cloud_ids="$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter label=com.docker.compose.service=cloud)"
  [[ "$(printf '%s\n' "$cloud_ids" | sed '/^$/d' | wc -l)" -eq 1 ]] || die 'expected exactly one existing Cloud service container'
  [[ "$(docker inspect --format '{{.State.Health.Status}}' "$cloud_ids")" == healthy ]] || die 'existing Cloud service is not healthy'
  cloud_port="$(docker inspect --format '{{range $port, $bindings := .NetworkSettings.Ports}}{{if eq $port "8000/tcp"}}{{range $bindings}}{{.HostIp}}:{{.HostPort}}{{end}}{{end}}{{end}}' "$cloud_ids")"
  [[ "$cloud_port" == 127.0.0.1:8000 ]] || die 'existing Cloud container does not own the expected 127.0.0.1:8000 mapping'
  printf '%s\n' "$pg_id"
}

assert_candidate_images() {
  local config expected_cloud expected_identity expected_proxy
  expected_cloud="ghcr.io/aarondyl/datashield-cloud@$1"
  expected_identity="ghcr.io/aarondyl/datashield-identity@$2"
  expected_proxy="ghcr.io/aarondyl/datashield-cloud-proxy@$3"
  config="$(compose --profile identity --profile production config --format json 2>/dev/null)" || die 'candidate Compose configuration is invalid'
  printf '%s' "$config" | python3 -c 'import json,sys; d=json.load(sys.stdin); s=d["services"]; assert set(s)=={"postgres","cloud","identity","gateway"}; assert s["cloud"]["image"]==sys.argv[1]; assert s["identity"]["image"]==sys.argv[2]; assert s["gateway"]["image"]==sys.argv[3]; assert int(s["cloud"]["mem_limit"])<=400*1024**2; assert int(s["identity"]["mem_limit"])<=192*1024**2; assert int(s["gateway"]["mem_limit"])<=80*1024**2' "$expected_cloud" "$expected_identity" "$expected_proxy" >/dev/null \
    || die 'existing ECS override changes a SHA-pinned image or exceeds the reviewed app memory limits'
  unset config
}

run_readonly_diagnostic() {
  local sha="$1" compose_sha="$2" cloud_digest="$3" identity_digest="$4" proxy_digest="$5"
  local cloud_id compose_json

  /usr/local/libexec/datashield-cloud/check-cloud-config.sh
  . "$SECRETS/cloud.env" >/dev/null 2>&1 || die 'Cloud configuration cannot be loaded; values were suppressed'
  docker info >/dev/null 2>&1 || die 'Docker daemon is unavailable'
  "${COMPOSE[@]}" version >/dev/null 2>&1 || die 'Docker Compose plugin is unavailable'
  df -Pk "$ROOT" | awk 'NR==2 { if ($4 < 5242880) exit 1 }' || die 'less than 5 GiB free under deployment filesystem'
  awk '/MemAvailable:/ { if ($2 < 614400) exit 1; found=1 } END { if (!found) exit 1 }' /proc/meminfo || die 'less than 600 MiB currently available'
  diagnostic_tmp="$(mktemp -d /tmp/datashield-cloud-diagnose.XXXXXXXX)"
  chmod 0700 "$diagnostic_tmp"
  printf 'CLOUD_IMAGE=ghcr.io/aarondyl/datashield-cloud@%s\nIDENTITY_IMAGE=ghcr.io/aarondyl/datashield-identity@%s\nPROXY_IMAGE=ghcr.io/aarondyl/datashield-cloud-proxy@%s\nDATASHIELD_RELEASE_SHA=%s\n' \
    "$cloud_digest" "$identity_digest" "$proxy_digest" "$sha" > "$diagnostic_tmp/candidate.env"
  chmod 0600 "$diagnostic_tmp/candidate.env"
  BASE="$(assert_staged_compose_release "$sha" "$compose_sha" "$cloud_digest" "$identity_digest" "$proxy_digest")"
  EXTRA_ENV_FILES+=(--env-file "$diagnostic_tmp/candidate.env")
  [[ -f "$ECS_BASE" ]] || die 'existing source ECS Compose overlay is missing'
  assert_existing_storage >/dev/null
  assert_candidate_images "$cloud_digest" "$identity_digest" "$proxy_digest"
  compose_json="$(compose --profile identity --profile production config --format json 2>/dev/null)" || die 'candidate merged Compose configuration is invalid'
  printf '%s' "$compose_json" | python3 -c 'import json,sys; d=json.load(sys.stdin); s=d["services"]; assert set(("cloud","identity","gateway")) <= set(s); assert all(not any(p.get("host_ip")=="0.0.0.0" for p in s[name].get("ports",[])) for name in ("cloud","identity")); assert not s["postgres"].get("ports"); assert all(x.get("condition")=="service_healthy" for x in s["gateway"]["depends_on"].values())' >/dev/null \
    || die 'candidate Compose service dependencies or API/database port exposure are invalid'
  unset compose_json

  cloud_id="$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter label=com.docker.compose.service=cloud)"
  [[ "$(printf '%s\n' "$cloud_id" | sed '/^$/d' | wc -l)" -eq 1 ]] || die 'expected exactly one running Cloud service for read-only database checks'
  if ! {
    cat "$CLOUD_SECRETS_DIR/cloud_database_url"
    printf '\n'
    cat "$CLOUD_SECRETS_DIR/identity_database_url"
    printf '\n'
  } | docker exec -i "$cloud_id" python -c '
import sys
from sqlalchemy import create_engine, text
from sqlalchemy.engine import make_url

urls = [line.strip() for line in sys.stdin if line.strip()]
assert len(urls) == 2
observed = []
for index, raw_url in enumerate(urls):
    parsed = make_url(raw_url)
    engine = create_engine(parsed, pool_pre_ping=True, connect_args={"connect_timeout": 5})
    with engine.connect() as connection:
        row = connection.execute(text("""
            SELECT current_database(), current_user,
                   has_database_privilege(current_user, current_database(), :connect_priv),
                   has_schema_privilege(current_user, :schema_name, :create_priv),
                   COALESCE((SELECT rolsuper FROM pg_roles WHERE rolname = current_user), false),
                   EXISTS (SELECT 1 FROM pg_extension WHERE extname = :extension_name),
                   EXISTS (SELECT 1 FROM pg_available_extension_versions WHERE name = :extension_name AND trusted)
        """), {"connect_priv": "CONNECT", "schema_name": "public", "create_priv": "CREATE", "extension_name": "vector"}).one()
        assert row[2] and row[3]
        if index == 0:
            assert row[5] or row[4] or row[6], "Cloud role cannot create pgvector if it is absent"
        observed.append((row[0], row[1]))
    engine.dispose()
assert observed[0][0] != observed[1][0] and observed[0][1] != observed[1][1]
print("DB_CONNECTIONS_OK")
' 2>/dev/null | grep -Fxq 'DB_CONNECTIONS_OK'; then
    die 'Cloud/Identity database or role check failed; URL and driver diagnostics were suppressed'
  fi

  docker_config="$(mktemp -d "$diagnostic_tmp/docker-config.XXXXXXXX")"
  chmod 0700 "$docker_config"
  if ! DOCKER_CONFIG="$docker_config" docker login ghcr.io --username "$GHCR_PULL_USERNAME" --password-stdin < "$SECRETS/ghcr_pull_token" >/dev/null 2>&1; then
    die 'GHCR credentials were rejected; token and registry output were suppressed'
  fi
  for manifest in \
    "ghcr.io/aarondyl/datashield-cloud@$cloud_digest" \
    "ghcr.io/aarondyl/datashield-identity@$identity_digest" \
    "ghcr.io/aarondyl/datashield-cloud-proxy@$proxy_digest"; do
    if ! DOCKER_CONFIG="$docker_config" docker manifest inspect "$manifest" >/dev/null 2>&1; then
      die 'GHCR could not resolve a requested immutable image manifest; registry output was suppressed'
    fi
  done
  rm -rf -- "$docker_config"
  docker_config=""
  echo 'Read-only deployment diagnosis passed: merged Compose, storage identity, Cloud/Identity DB roles, GHCR access, disk, and memory.'
}

source /usr/local/libexec/datashield-cloud/cloud-deploy-state.sh

restore_previous_cloud() {
  local previous_sha
  if [[ -s "$ROOT/last-good.env" ]]; then
    previous_sha="$(sed -n 's/^DATASHIELD_RELEASE_SHA=//p' "$ROOT/last-good.env")"
    if [[ "$previous_sha" =~ ^[0-9a-f]{40}$ && -f "$ROOT/releases/$previous_sha/docker-compose.cloud.yml" ]]; then
      cp "$ROOT/last-good.env" "$STATE"
      chmod 0600 "$STATE"
      BASE="$ROOT/releases/$previous_sha/docker-compose.cloud.yml"
      EXTRA_ENV_FILES+=(--env-file "$STATE")
      if compose --profile production --profile identity up -d --no-build --no-deps cloud identity gateway >> "$LOG" 2>&1; then
        log "application rollback restored $previous_sha; database was not downgraded"
        return 0
      fi
      log "application rollback failed; database was not downgraded"
      return 1
    fi
  fi
  restore_first_cutover_state
}

activation_started=0
finish() {
  status=$?
  [[ -z "$docker_config" ]] || rm -rf -- "$docker_config"
  [[ -z "$diagnostic_tmp" ]] || rm -rf -- "$diagnostic_tmp"
  rollback_after_failed_activation "$status"
  exit "$status"
}
trap finish EXIT

[[ $EUID -eq 0 ]] || die 'must run as root'
[[ $# -ge 1 ]] || die 'expected audit, preflight, deploy, or rollback'
[[ -d "$ROOT" && ! -L "$ROOT" && -d "$ROOT/releases" && -d "$ROOT/backups" && -d "$SECRETS" && ! -L "$SECRETS" ]] \
  || die 'deployment directories are missing; run the approved host installer first'
[[ "$(stat -c '%U:%G:%a' "$ROOT")" == root:root:700 && "$(stat -c '%U:%G:%a' "$SECRETS")" == root:root:700 ]] \
  || die 'deployment directories have unsafe ownership or mode'
[[ -x /usr/local/libexec/datashield-cloud/check-cloud-config.sh ]] || die 'host installer has not installed the configuration checker'
[[ -f "$SECRETS/cloud.env" && ! -L "$SECRETS/cloud.env" ]] || die 'cloud.env is missing'

case "$1" in
  audit)
    printf 'service='; systemctl is-active datashield.service 2>/dev/null || true
    printf 'docker='; docker info --format '{{.ServerVersion}}' 2>/dev/null || true
    printf 'compose='; "${COMPOSE[@]}" version --short 2>/dev/null || true
    printf 'project=%s\n' "$PROJECT"
    printf 'project_containers='; docker ps -q --filter "label=com.docker.compose.project=$PROJECT" | wc -l
    printf 'port_8000='; ss -lnt '( sport = :8000 )' | tail -n +2 | wc -l
    printf 'port_8001='; ss -lnt '( sport = :8001 )' | tail -n +2 | wc -l
    printf 'active_sha='; if [[ -r $ACTIVE ]]; then cat "$ACTIVE"; else echo none; fi
    exit 0
    ;;
  preflight)
    [[ $# -eq 1 ]] || die 'preflight accepts no arguments'
    /usr/local/libexec/datashield-cloud/check-cloud-config.sh
    docker info >/dev/null 2>&1 || die 'Docker daemon is unavailable'
    "${COMPOSE[@]}" version >/dev/null 2>&1 || die 'Docker Compose plugin is unavailable'
    df -Pk "$ROOT" | awk 'NR==2 { if ($4 < 5242880) exit 1 }' || die 'less than 5 GiB free under deployment filesystem'
    awk '/MemAvailable:/ { if ($2 < 614400) exit 1; found=1 } END { if (!found) exit 1 }' /proc/meminfo || die 'less than 600 MiB currently available; refusing memory-intensive migration preflight'
    [[ -f "$BASE" && -f "$ECS_BASE" ]] || die 'both existing source Compose files must remain present'
    assert_existing_storage >/dev/null
    echo 'Preflight passed; source_cloud_postgres_data is attached and no data or containers were changed.'
    ;;
  diagnose)
    [[ $# -eq 6 ]] || die 'diagnose requires SHA, Compose SHA256, and three image digests'
    sha="$2" compose_sha="$3" cloud_digest="$4" identity_digest="$5" proxy_digest="$6"
    run_readonly_diagnostic "$sha" "$compose_sha" "$cloud_digest" "$identity_digest" "$proxy_digest"
    ;;
  stage)
    [[ $# -eq 6 ]] || die 'stage requires SHA, Compose SHA256, and three image digests'
    stage_compose_release "$2" "$3" "$4" "$5" "$6"
    ;;
  deploy)
    [[ $# -eq 6 ]] || die 'deploy requires SHA, Compose SHA256, and three image digests'
    exec 9>"$ROOT/deploy.lock"
    chmod 0600 "$ROOT/deploy.lock"
    flock -n 9 || die 'another Cloud deployment is already running'
    sha="$2" compose_sha="$3" cloud_digest="$4" identity_digest="$5" proxy_digest="$6"
    validate_release_arguments "$sha" "$compose_sha" "$cloud_digest" "$identity_digest" "$proxy_digest"
    /usr/local/libexec/datashield-cloud/check-cloud-config.sh
    . "$SECRETS/cloud.env" >/dev/null 2>&1
    docker info >/dev/null 2>&1 || die 'Docker daemon is unavailable'
    "${COMPOSE[@]}" version >/dev/null 2>&1 || die 'Docker Compose plugin is unavailable'
    df -Pk "$ROOT" | awk 'NR==2 { if ($4 < 5242880) exit 1 }' || die 'less than 5 GiB free under deployment filesystem'
    awk '/MemAvailable:/ { if ($2 < 614400) exit 1; found=1 } END { if (!found) exit 1 }' /proc/meminfo || die 'less than 600 MiB currently available; refusing memory-intensive deployment'
    [[ -f "$BASE" && -f "$ECS_BASE" ]] || die 'both existing source Compose files must remain present'
    postgres_before="$(assert_existing_storage)"
    release="$(assert_staged_compose_release "$sha" "$compose_sha" "$cloud_digest" "$identity_digest" "$proxy_digest")"
    if [[ ! -e "$ROOT/production-cutover.approved" ]]; then
      active_service=0
      systemctl is-active --quiet datashield.service 2>/dev/null && active_service=1 || true
      if [[ "$active_service" -eq 1 ]]; then die 'first production cutover requires root-created production-cutover.approved after explicit operator approval'; fi
      die 'first production cutover requires root-created production-cutover.approved after explicit operator approval'
    fi
    [[ -f "$ROOT/production-cutover.approved" && ! -L "$ROOT/production-cutover.approved" && "$(stat -c '%U:%G:%a' "$ROOT/production-cutover.approved")" == root:root:600 ]] || die 'production-cutover.approved must be a root-owned regular 0600 file'
    save_first_cutover_state
    # The running compose project must already use this stack and volume identity.
    BASE="$release/docker-compose.cloud.yml"
    if [[ -s "$STATE" ]]; then cp -f "$STATE" "$ROOT/last-good.env"; chmod 0600 "$ROOT/last-good.env"; fi
    candidate="$ROOT/candidate.env"
    printf 'CLOUD_IMAGE=ghcr.io/aarondyl/datashield-cloud@%s\nIDENTITY_IMAGE=ghcr.io/aarondyl/datashield-identity@%s\nPROXY_IMAGE=ghcr.io/aarondyl/datashield-cloud-proxy@%s\nDATASHIELD_RELEASE_SHA=%s\n' "$cloud_digest" "$identity_digest" "$proxy_digest" "$sha" > "$candidate"
    chmod 0600 "$candidate"
    # Keep current.env as the last active version until health checks pass.
    EXTRA_ENV_FILES+=(--env-file "$candidate")
    [[ "$(assert_existing_storage)" == "$postgres_before" ]] || die 'candidate Compose release does not resolve to the existing PostgreSQL container and volume'
    assert_candidate_images "$cloud_digest" "$identity_digest" "$proxy_digest"
    docker_config="$(mktemp -d "$ROOT/.docker-config.XXXXXXXX")"
    chmod 0700 "$docker_config"
    token_file="$SECRETS/ghcr_pull_token"
    [[ -s "$token_file" ]] || die 'GHCR_PULL_TOKEN_FILE is empty'
    DOCKER_CONFIG="$docker_config" docker login ghcr.io --username "$GHCR_PULL_USERNAME" --password-stdin < "$token_file" >/dev/null 2>&1 || die 'GHCR registry login failed'
    export DOCKER_CONFIG="$docker_config"
    docker pull "ghcr.io/aarondyl/datashield-cloud@$cloud_digest" >/dev/null
    docker pull "ghcr.io/aarondyl/datashield-identity@$identity_digest" >/dev/null
    docker pull "ghcr.io/aarondyl/datashield-cloud-proxy@$proxy_digest" >/dev/null
    backup="$ROOT/backups/pre-$sha-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
    postgres_id="$(assert_existing_storage)"
    [[ -n "$postgres_id" ]] || die 'PostgreSQL container missing after image pulls'
    docker exec "$postgres_id" pg_dumpall -U datashield_cloud | gzip -1 > "$backup" || { rm -f "$backup"; die 'database backup failed; migrations not run'; }
    chmod 0600 "$backup"
    gzip -t "$backup" || die 'database backup archive validation failed; migrations not run'
    log "database backup completed for $sha"
    if ! compose run --rm --no-deps cloud alembic -c alembic-cloud.ini upgrade head >> "$LOG" 2>&1; then die 'Cloud migration failed; database left intact and application not switched'; fi
    if ! compose --profile identity run --rm --no-deps identity alembic -c alembic-identity.ini upgrade head >> "$LOG" 2>&1; then die 'Identity migration failed; database left intact and application not switched'; fi
    activation_started=1
    if ! compose --profile production --profile identity up -d --no-build --no-deps cloud identity gateway >> "$LOG" 2>&1; then die 'Compose activation failed; see root-only deploy log'; fi
    [[ "$(existing_postgres_id)" == "$postgres_before" ]] || die 'PostgreSQL container identity changed during deployment; investigate before proceeding'
    for _ in {1..40}; do
      if compose exec -T cloud python -c 'import json,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8000/api/health",timeout=4)); assert d.get("status")=="ok" and d.get("db")=="postgresql"' >/dev/null 2>&1 \
        && compose exec -T identity python -c 'import json,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8001/health",timeout=4)); assert d.get("status")=="ok" and d.get("database")=="postgresql" and d.get("email_delivery_ready")' >/dev/null 2>&1; then break; fi
      sleep 3
    done
    compose exec -T cloud python -c 'import json,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8000/api/health",timeout=4)); assert d.get("status")=="ok" and d.get("db")=="postgresql"'
    compose exec -T identity python -c 'import json,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8001/health",timeout=4)); assert d.get("status")=="ok" and d.get("database")=="postgresql" and d.get("email_delivery_ready")'
    cp "$candidate" "$STATE"
    chmod 0600 "$STATE"
    printf '%s\n' "$sha" > "$ACTIVE"
    chmod 0600 "$ACTIVE"
    log "deployment succeeded source=$sha cloud=$cloud_digest identity=$identity_digest proxy=$proxy_digest"
    echo "Deployment activated; source=$sha. External HTTPS smoke tests are still required."
    ;;
  rollback)
    [[ $# -eq 1 ]] || die 'rollback accepts no user-supplied command or version'
    exec 9>"$ROOT/deploy.lock"
    chmod 0600 "$ROOT/deploy.lock"
    flock -n 9 || die 'another Cloud deployment is already running'
    [[ -f "$BASE" && -f "$ECS_BASE" ]] || die 'existing source Compose files are unavailable'
    restore_previous_cloud || die 'application rollback failed; inspect the root-only deployment log'
    if [[ -s "$ROOT/last-good.env" ]]; then
      rollback_sha="$(sed -n 's/^DATASHIELD_RELEASE_SHA=//p' "$ROOT/last-good.env")"
      valid_sha "$rollback_sha" || die 'saved last-good release SHA is invalid'
      printf '%s\n' "$rollback_sha" > "$ACTIVE"
      chmod 0600 "$ACTIVE"
      echo "Application images restored to $rollback_sha. Database migrations were not rolled back."
    else
      rm -f "$STATE" "$ACTIVE"
      echo 'Pre-CI Cloud image restored. Database migrations were not rolled back.'
    fi
    ;;
  *) die 'unknown command' ;;
esac
